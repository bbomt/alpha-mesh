# secrets — never commit
config/active.json

# local DB — back up separately, don't commit
tasks/task-log.db
tasks/*.db

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Python project
venv/
agents/*/*.egg-info/
agents/*/.venv/
agents/*/uv.lock
uv.lock

# editor
.DS_Store
*.swp
.env

# Claude Code runtime dir (holds tokens in settings.json; never track)
.claude/
