#!/usr/bin/env bash
# alpha-mesh/scripts/model
# Replaces manual settings.json swapping.
# Tokens: stored in env vars or .env (never commit secrets to GitHub)
#
# Syntax:
#   model use {-g|-l} <profile> [model]   switch profile with explicit scope
#   model use <profile> [model]             switch profile (prompts for scope)
#   model status                            show local and global model settings
#   model list                              show all profiles with descriptions
#   model check [profile]                  health check without switching (default: current)
#
# Scope flags:
#   -g, --global   write to ~/.claude/settings.json (affects all windows)
#   -l, --local    write to .claude/settings.json (repo-level, takes precedence)
#
# Profile examples:
#   model use minimax                minimax, prompts for scope
#   model use -g minimax             minimax, global scope
#   model use -l minimax             minimax, local scope
#   model use openrouter glm-5.1     openrouter with specific model
#   model use openrouter             openrouter with default model from config
#
# Model override (provider/model shorthand):
#   model use openrouter z-ai/glm-5.1

set -euo pipefail

# Resolve script's real directory regardless of cwd
SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
BRAIN_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
MODELS_JSON="$BRAIN_DIR/config/models.json"
ENV_FILE="$BRAIN_DIR/.env"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"

# Requires jq
if ! command -v jq &>/dev/null; then
  echo "ERROR: jq is required. Install with: sudo apt-get install jq" >&2
  exit 1
fi

# Load .env if it exists
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

cmd="${1:-status}"

# Resolve shorthand profile name to full name
# e.g. "openrouter" → "openrouter-default", "claude" → "claude-sonnet"
resolve_profile() {
  local shorthand="$1"
  # Exact match
  if jq -e --arg p "$shorthand" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
    echo "$shorthand"
    return 0
  fi
  # Provider shorthand → profile mapping
  case "$shorthand" in
    openrouter) echo "openrouter-default" ;;
    claude)     echo "claude-sonnet" ;;
    *)          # Try appending common suffixes
      for suffix in "-default" "-claude" "-sonnet" "-haiku" "-opus"; do
        local candidate="${shorthand}${suffix}"
        if jq -e --arg p "$candidate" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
          echo "$candidate"
          return 0
        fi
      done
      echo "$shorthand"
      ;;
  esac
}

list_profiles() {
  echo "Available model profiles:"
  jq -r '.profiles | to_entries[] | "  \(.key)  —  \(.value.description)"' "$MODELS_JSON"
  echo ""
  default=$(jq -r '.default' "$MODELS_JSON")
  echo "Default: $default"
}

# Get token for a profile: env var takes precedence over models.json placeholder
# Env var name is ALPHA_MESH_{PROVIDER}_TOKEN where provider comes from models.json
# e.g. "openrouter-default" has provider "openrouter" → ALPHA_MESH_OPENROUTER_TOKEN
#       "claude-sonnet" has provider "anthropic" → ALPHA_MESH_ANTHROPIC_TOKEN
get_token() {
  local profile="$1"
  local provider
  provider=$(jq -r --arg p "$profile" '.profiles[$p].provider // ($p | split("-")[0])' "$MODELS_JSON")
  local env_var="ALPHA_MESH_${provider^^}_TOKEN"
  local token="${!env_var:-}"

  # If env var is set, use it; otherwise fall back to models.json
  if [[ -n "$token" ]]; then
    echo "$token"
  else
    jq -r --arg p "$profile" '.profiles[$p].env.ANTHROPIC_AUTH_TOKEN // .profiles[$p].env.ANTHROPIC_API_KEY // ""' "$MODELS_JSON"
  fi
}

health_check() {
  local profile="$1"
  local base_url token

  base_url=$(jq -r --arg p "$profile" '.profiles[$p].env.ANTHROPIC_BASE_URL' "$MODELS_JSON")

  if [[ -z "$base_url" || "$base_url" == "null" ]]; then
    # Native Anthropic — check api.anthropic.com
    base_url="https://api.anthropic.com"
  fi

  # Check the actual API endpoint (append /v1/models for health check)
  # This avoids false negatives from stripped paths
  health_url="${base_url%/}/v1/models"

  echo -n "  Checking $profile ($health_url) ... "
  token=$(get_token "$profile")
  if [[ -z "$token" || "$token" == "REPLACE_WITH_"* ]]; then
    echo "⚠ no token configured (set ALPHA_MESH_${profile^^}_TOKEN env var or in config/.env)"
    return 1
  fi

  if curl -sf --max-time 5 "$health_url" \
    -H "Authorization: Bearer $token" \
    -o /dev/null 2>&1; then
    echo "✓ reachable"
    return 0
  else
    echo "✗ unreachable"
    return 1
  fi
}

write_settings() {
  local profile="$1"
  local model_override="${2:-}"
  local scope="${3:-}"

  # Validate profile exists
  if ! jq -e --arg p "$profile" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
    echo "ERROR: Unknown profile '$profile'" >&2
    echo "Run: model list" >&2
    exit 1
  fi

  # Resolve target settings file based on scope
  # local = repo root (walks up to find .git or .claude, then .claude/settings.json)
  # global = $HOME/.claude/settings.json (affects all windows)
  local target_settings
  case "$scope" in
    local)
      # Walk up from CWD to find repo root (contains .git — true git repo marker)
      repo_root="$PWD"
      while [[ "$repo_root" != "/" ]]; do
        if [[ -d "$repo_root/.git" ]]; then
          break
        fi
        repo_root="$(dirname "$repo_root")"
      done

      # If no git repo found, confirm before writing to CWD
      if [[ "$repo_root" == "/" ]]; then
        echo "No git repo found. Write to \$PWD/.claude/settings.json?" >&2
        read -rp "Confirm [y/N]: " confirm >&2
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
          echo "Aborted." >&2
          exit 1
        fi
        repo_root="$PWD"
      fi

      target_settings="$repo_root/.claude/settings.json"
      ;;
    global) target_settings="$HOME/.claude/settings.json" ;;
    *)
      echo "ERROR: invalid scope '$scope'" >&2
      exit 1
      ;;
  esac

  # Ensure parent directory exists for local scope
  if [[ "$scope" == "local" ]]; then
    mkdir -p "$(dirname "$target_settings")"
  fi

  # Build env block from models.json, then overlay token and optionally model
  local env_block token
  env_block=$(jq --arg p "$profile" '.profiles[$p].env' "$MODELS_JSON")
  token=$(get_token "$profile")

  # Replace the token and optionally override the model
  # Only set ANTHROPIC_API_KEY when models.json explicitly has a value for it (used by Anthropic direct)
  # ANTHROPIC_AUTH_TOKEN is always set (used by minimax/openrouter)
  if [[ -n "$model_override" ]]; then
    env_block=$(echo "$env_block" | jq \
      --arg token "$token" \
      --arg model "$model_override" \
      '.ANTHROPIC_AUTH_TOKEN = $token | .ANTHROPIC_MODEL = $model | .ANTHROPIC_DEFAULT_SONNET_MODEL = $model | .ANTHROPIC_DEFAULT_OPUS_MODEL = $model | if (.ANTHROPIC_API_KEY | length > 0) then .ANTHROPIC_API_KEY = $token else . end')
  else
    env_block=$(echo "$env_block" | jq \
      --arg token "$token" \
      '.ANTHROPIC_AUTH_TOKEN = $token | if (.ANTHROPIC_API_KEY | length > 0) then .ANTHROPIC_API_KEY = $token else . end')
  fi

  # Backup existing settings
  if [[ -f "$target_settings" ]]; then
    cp "$target_settings" "$target_settings.bak"
  fi

  # Merge with existing settings to preserve other top-level keys (e.g. hooks)
  if [[ -f "$target_settings" ]]; then
    local merged
    merged=$(jq --argjson newenv "$env_block" '.env = $newenv' "$target_settings")
    echo "$merged" > "$target_settings"
  else
    jq -n --argjson env "$env_block" '{"env": $env}' > "$target_settings"
  fi

  echo "✓ Active model: $profile${model_override:+, model: '"$model_override"'}"
  echo "  Scope: $scope | Settings: $target_settings"
  jq -r --arg p "$profile" '.profiles[$p].description' "$MODELS_JSON"
}

case "$cmd" in
  list)
    list_profiles
    ;;

  status)
    default=$(jq -r '.default' "$MODELS_JSON")
    echo "Default profile: $default (set in config/models.json)"
    echo ""

    # Show local scope (repo root — same path model use -l would write)
    repo_root="$PWD"
    while [[ "$repo_root" != "/" ]]; do
      if [[ -d "$repo_root/.git" ]]; then
        break
      fi
      repo_root="$(dirname "$repo_root")"
    done
    local_settings="$repo_root/.claude/settings.json"
    if [[ -f "$local_settings" ]]; then
      local_model=$(jq -r '.env.ANTHROPIC_MODEL // .env.ANTHROPIC_DEFAULT_SONNET_MODEL // "?"' "$local_settings")
      echo "LOCAL:  $local_settings"
      echo "        model: $local_model"
    fi

    # Show global scope
    echo "GLOBAL: $CLAUDE_SETTINGS"
    if [[ -f "$CLAUDE_SETTINGS" ]]; then
      global_model=$(jq -r '.env.ANTHROPIC_MODEL // .env.ANTHROPIC_DEFAULT_SONNET_MODEL // "?"' "$CLAUDE_SETTINGS")
      echo "        model: $global_model"
    fi
    ;;

  use)
    # Format: model use {-g|-l} <profile> [model]
    #   e.g. model use -g minimax
    #   e.g. model use -l openrouter glm-5.1
    #   e.g. model use --local openrouter
    # Or: model use <profile> [model]  → offers local/global choice

    first="${2:-}"

    if [[ -z "$first" ]]; then
      echo "Usage: model use {-g|-l} <profile> [model]" >&2
      echo "  e.g. model use -g minimax" >&2
      echo "  e.g. model use -l openrouter glm-5.1" >&2
      list_profiles
      exit 1
    fi

    # Detect if first arg is a scope flag
    case "$first" in
      -g|--global) scope="global";  profile="${3:-}"; model_override="${4:-}" ;;
      -l|--local)  scope="local";   profile="${3:-}"; model_override="${4:-}" ;;
      *)
        # No flag — offer choice
        profile="$first"
        model_override="${3:-}"
        echo "Choose scope:" >&2
        echo "  L) LOCAL  — $BRAIN_DIR/.claude/settings.json (repo-level, takes precedence)" >&2
        echo "  G) GLOBAL — $HOME/.claude/settings.json (affects all windows)" >&2
        read -rp "Select L-G [L]: " reply >&2
        scope="local"
        [[ "$reply" == "G" || "$reply" == "g" ]] && scope="global"
        ;;
    esac

    if [[ -z "$profile" ]]; then
      echo "ERROR: profile required" >&2
      echo "Usage: model use {-g|-l} <profile> [model]" >&2
      exit 1
    fi

    # Support: model use provider/model  (slash-separated shorthand)
    if [[ -z "$model_override" && "$profile" == *"/"* ]]; then
      model_override="${profile#*/}"
      profile="${profile%%/*}"
    fi

    profile=$(resolve_profile "$profile")

    echo "Switching to: $profile${model_override:+, model: '"$model_override"'}"
    health_check "$profile" || {
      echo ""
      echo "WARNING: $profile appears unreachable. Checking fallbacks..."
      fallbacks=$(jq -r '.fallback_order[]' "$MODELS_JSON")
      for fb in $fallbacks; do
        [[ "$fb" == "$profile" ]] && continue
        health_check "$fb" && {
          echo ""
          read -rp "Use $fb instead? [y/N] " confirm
          [[ "$confirm" =~ ^[Yy]$ ]] && profile="$fb" && break
        }
      done
    }
    write_settings "$profile" "$model_override" "$scope"
    ;;

  check)
    profile="${2:-minimax}"
    echo "Health checking: $profile"
    health_check "$profile"
    ;;

  *)
    echo "Usage: model <command>"
    echo "Commands: use <profile> | status | list | check [profile]"
    exit 1
    ;;
esac
