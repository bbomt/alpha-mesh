#!/usr/bin/env bash
# alpha-mesh/test/test-task-log
# Tests for bin/task-log script

set -euo pipefail

MESH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$MESH_DIR/bin:$PATH"
cd "$MESH_DIR"

FAILED=0
TEST_TICKET="PMAT-TEST-$$"

echo "=== task-log tests ==="
echo ""

# ─── test: bin/task-log exists and is executable ───────────────────────────────
echo "[1/6] bin/task-log exists and is executable..."
if [[ -x "$MESH_DIR/bin/task-log" ]]; then
  echo "  PASS"
else
  echo "  FAIL: bin/task-log not found or not executable"
  FAILED=1
fi

# ─── setup: use a temp DB so we don't touch live data ─────────────────────────
TMP_DB_DIR=$(mktemp -d)
TMP_DB="$TMP_DB_DIR/task-log.db"

# ─── test: task-log start creates a row ─────────────────────────────────────────
echo "[2/6] task-log start creates a row..."
# Create fresh DB for test
rm -f "$TMP_DB"
if TASK_DB="$TMP_DB" task-log start "$TEST_TICKET" "Test task" --repo alpha-mesh >/dev/null 2>&1; then
  echo "  PASS: task-log start succeeded"
else
  echo "  FAIL: task-log start failed"
  FAILED=1
fi

# ─── test: task-log done updates the row ────────────────────────────────────────
echo "[3/6] task-log done updates the row..."
if TASK_DB="$TMP_DB" task-log done "$TEST_TICKET" --outcome "test passed" >/dev/null 2>&1; then
  echo "  PASS: task-log done succeeded"
else
  echo "  FAIL: task-log done failed"
  FAILED=1
fi

# ─── test: task-log show returns the outcome ────────────────────────────────────
echo "[4/6] task-log show returns the outcome..."
output=$(TASK_DB="$TMP_DB" task-log show "$TEST_TICKET" 2>&1)
if echo "$output" | grep -q "test passed"; then
  echo "  PASS: task-log show contains outcome"
else
  echo "  FAIL: task-log show did not contain outcome"
  FAILED=1
fi

# ─── test: task-log recent works ────────────────────────────────────────────────
echo "[5/6] task-log recent works..."
output=$(TASK_DB="$TMP_DB" task-log recent 5 2>&1)
if echo "$output" | grep -q "$TEST_TICKET"; then
  echo "  PASS: task-log recent shows test ticket"
else
  echo "  FAIL: task-log recent did not show test ticket"
  FAILED=1
fi

# ─── test: task-log export returns valid JSON ───────────────────────────────────
echo "[6/6] task-log export returns valid JSON..."
output=$(TASK_DB="$TMP_DB" task-log export 1 2>&1)
if echo "$output" | jq . >/dev/null 2>&1; then
  echo "  PASS: task-log export is valid JSON"
else
  echo "  FAIL: task-log export is not valid JSON"
  FAILED=1
fi

# ─── cleanup ─────────────────────────────────────────────────────────────────────
rm -rf "$TMP_DB_DIR"

# ─── summary ────────────────────────────────────────────────────────────────────
echo ""
if [[ "$FAILED" -eq 0 ]]; then
  echo "=== ALL TASK-LOG TESTS PASSED ==="
  exit 0
else
  echo "=== SOME TASK-LOG TESTS FAILED ==="
  exit 1
fi