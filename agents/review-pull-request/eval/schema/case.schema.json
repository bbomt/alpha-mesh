{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "review-pull-request eval case",
  "description": "One eval case (eval/README.md). expected holds properties a good review has, never expected text.",
  "type": "object",
  "required": [
    "case_id",
    "repo",
    "pr_number",
    "label",
    "category",
    "expected",
    "notes"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "raised_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "fix_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "enum": [
        "false_positive",
        "real_issue"
      ]
    },
    "label_by": {
      "type": "string"
    },
    "label_date": {
      "type": "string"
    },
    "label_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "mined",
        "logic",
        "security",
        "style_only",
        "refactor",
        "concurrency",
        "improvable",
        "degenerate"
      ]
    },
    "expected": {
      "type": "object",
      "required": [
        "action",
        "flag_file"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "raise_true_bug",
            "skip_false_bug",
            "raise_nothing"
          ]
        },
        "flag_file": {
          "type": "string",
          "minLength": 1
        },
        "min_severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "must_mention_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "$comment": "a glob only with raise_nothing: a true or false bug is one finding in one file",
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "raise_true_bug",
                  "skip_false_bug"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "flag_file": {
                "pattern": "^[^*?\\[]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "raise_true_bug"
              }
            }
          },
          "then": {
            "required": [
              "min_severity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "skip_false_bug"
              }
            }
          },
          "then": {
            "properties": {
              "min_severity": false,
              "must_mention_any": false
            }
          }
        },
        {
          "$comment": "min_severity is optional: findings below it do not count; without it, any finding counts",
          "if": {
            "properties": {
              "action": {
                "const": "raise_nothing"
              }
            }
          },
          "then": {
            "properties": {
              "must_mention_any": false
            }
          }
        }
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$comment": "a true or false bug is reviewed at raised_sha (diff base_sha...raised_sha) and matched by its line there (within a window), so it must have all three",
      "if": {
        "properties": {
          "expected": {
            "properties": {
              "action": {
                "enum": [
                  "raise_true_bug",
                  "skip_false_bug"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "finding",
          "base_sha",
          "raised_sha"
        ],
        "properties": {
          "base_sha": {
            "type": "string",
            "minLength": 7
          },
          "raised_sha": {
            "type": "string",
            "minLength": 7
          },
          "finding": {
            "type": "object",
            "required": [
              "line"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
