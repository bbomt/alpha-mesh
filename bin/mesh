#!/usr/bin/env bash
# alpha-mesh/bin/mesh
# Unified CLI entry point — dispatches to individual command scripts.
# Usage: mesh <command> [args]
#   e.g. mesh model use minimax
#       mesh task-log status
#       mesh dream

set -euo pipefail

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPTS_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")" && pwd)"

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  echo "Usage: mesh <command> [args]" >&2
  echo "Commands: model | task-log | dream | bootstrap-memory | test" >&2
  exit 1
fi

case "$cmd" in
  model|model_use)       shift; exec "$SCRIPTS_DIR/model" "$@" ;;
  task-log|task_log)     shift; exec "$SCRIPTS_DIR/task-log" "$@" ;;
  dream)                 shift; exec "$SCRIPTS_DIR/dream" "$@" ;;
  bootstrap-memory)      shift; exec "$SCRIPTS_DIR/bootstrap-memory" "$@" ;;
  test)                  shift; exec "$SCRIPTS_DIR/../test/run-all" "$@" ;;
  help|--help|-h)        echo "Usage: mesh <command> [args]" >&2
                         echo "Commands: model | task-log | dream | bootstrap-memory | test" >&2
                         exit 0 ;;
  *)
    echo "ERROR: unknown command '$cmd'" >&2
    echo "Commands: model | task-log | dream | bootstrap-memory | test" >&2
    exit 1
    ;;
esac