# alpha-mesh tokens — copy this to .env and fill in your actual keys
# NEVER commit .env to GitHub

ALPHA_MESH_MINIMAX_TOKEN=your_minimax_key_here
ALPHA_MESH_OPENROUTER_TOKEN=your_openrouter_key_here
ALPHA_MESH_ANTHROPIC_TOKEN=your_anthropic_key_here

# CODE REVIEW — LLM credentials

CODE_REVIEW_MODEL=your-model-name-here
CODE_REVIEW_URL=https://openrouter.ai/api
CODE_REVIEW_TOKEN=your-token-here

# JUDGE — the eval's LLM judge (PMAT-311): a different model family from the review model

JUDGE_MODEL=your-judge-model-here
JUDGE_URL=https://openrouter.ai/api
JUDGE_TOKEN=your-token-here

# SILVER — the model that writes the judge's silver calibration labels (PMAT-326), sent to JUDGE_URL with JUDGE_TOKEN
SILVER_MODEL=openai/gpt-6.1-terra

# Checkpoint store for resumable reviews (optional; defaults suit the dev EC2, AWS credentials via SSO dev-EC2)
# DEPLOY_ENV=dev
# AWS_REGION=eu-west-1
# ALPHA_MESH_REVIEW_PULL_REQ_CHECKPOINT_TABLE=
# ALPHA_MESH_REVIEW_PULL_REQ_CHECKPOINT_BUCKET=
