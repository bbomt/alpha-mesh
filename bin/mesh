#!/usr/bin/env bash
# alpha-mesh/bin/mesh
# Unified CLI entry point — dispatches to individual command scripts.
# Usage: mesh <command> [args]
#   e.g. mesh model use minimax
#       mesh dream

set -euo pipefail

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPTS_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")" && pwd)"

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  echo "Usage: mesh <command> [args]" >&2
  echo "Commands: model | dream | review-pull-request | run-evals | merge-pr | sync-main | orchestrate | test" >&2
  exit 1
fi

case "$cmd" in
  model|model_use)       shift; exec "$SCRIPTS_DIR/model.sh" "$@" ;;
  dream)                 shift; exec "$SCRIPTS_DIR/dream.sh" "$@" ;;
  review-pull-request) shift; exec "$SCRIPTS_DIR/review-pull-request.sh" "$@" ;;
  run-evals)             shift; exec "$SCRIPTS_DIR/run-evals.sh" "$@" ;;
  merge-pr)              shift; exec "$SCRIPTS_DIR/merge-pr.sh" "$@" ;;
  sync-main)             shift; exec "$SCRIPTS_DIR/sync-main.sh" "$@" ;;
  orchestrate)           shift; exec "$SCRIPTS_DIR/orchestrate.sh" "$@" ;;
  test)                  shift; exec "$SCRIPTS_DIR/../test/run-all.sh" "$@" ;;
  help|--help|-h)        echo "Usage: mesh <command> [args]" >&2
                         echo "Commands: model | dream | review-pull-request | run-evals | merge-pr | sync-main | orchestrate | test" >&2
                         exit 0 ;;
  *)
    echo "ERROR: unknown command '$cmd'" >&2
    echo "Commands: model | dream | review-pull-request | run-evals | merge-pr | sync-main | orchestrate | test" >&2
    exit 1
    ;;
esac