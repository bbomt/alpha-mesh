#!/usr/bin/env bash
# alpha-mesh/bin/run-evals
# Run the review-pull-request evals on a PR and post the verdict (PMAT-312).
#
#   mesh run-evals <PR url>                  run the evals on the PR's head; post `evals` and the score table
#   mesh run-evals --quick <PR url>          a k=1 early warning (a third of the quota): a PR comment, no status
#   mesh run-evals --master                  run the evals on master's head, post `master-evals-gated`; a failure opens the revert PR
#   mesh override-evals <PR url> --reason R  post `evals` = success by hand ("override: R"), recorded on the PR
#
# mesh merge-pr --status <PR url> prints the merge status report (check_evals_gate_allows_merge.py) that these feed.
#
# An evals run is the full eval (the development cases, k=3, every repeat judged) in a clean worktree, compared with
# master's baseline and master's tolerance (decide_evals_gate_status.py), so a PR cannot loosen its own gate. About 75 min and about
# a day's free-model quota. Run it again on the same head to resume: a run stopped by the quota continues.

set -euo pipefail

mesh_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
agent_rel="agents/review-pull-request"
pr_re='^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)$'

usage() {
  sed -n '5,8p' "${BASH_SOURCE[0]}" | sed 's/^# */usage: /' >&2
  exit 2
}

pending_repo="" pending_sha="" pending_context=""
post_status() {  # post_status <repo> <sha> <context> <state> <description>
  gh api "repos/$1/statuses/$2" -f state="$4" -f context="$3" -f description="${5:0:140}" >/dev/null
  if [ "$4" = pending ]; then pending_repo="$1" pending_sha="$2" pending_context="$3"; else pending_sha=""; fi
}
# A run that stops before its verdict (a crash, a missing file) never leaves its status pending: it posts error.
on_exit() {
  local code=$?
  [ -z "$pending_sha" ] \
    || post_status "$pending_repo" "$pending_sha" "$pending_context" error \
         "mesh run-evals stopped before a verdict (exit $code): see its log" || true
  exit "$code"
}
trap on_exit EXIT

# run_gate <head> <run name> <base ref> [quick]: run the eval at <head> and score it against <base ref>'s baseline
# and tolerance. Leaves the report in $run_dir/gate.md and the verdict in $gate (0 pass, else fail); exits on a run
# the gate could not score, after posting $context = error on <head> (unless $context is empty: the quick check).
run_gate() {
  local head="$1" run="$2" ref="$3" mode="${4:-}" baseline_json tolerance
  local eval_args=(--judge-repeats all) check_args=()
  [ "$mode" = quick ] && eval_args=(--k 1 --judge-repeats first) check_args=(--quick)
  baseline_json="$(git -C "$mesh_dir" show "$ref:$agent_rel/eval/baseline.json")"
  local gate_src tolerance_note=""
  if ! gate_src="$(git -C "$mesh_dir" show "$ref:$agent_rel/eval/scripts/decide_evals_gate_status.py" 2>/dev/null)"; then
    # Only for the PR that installs the gate: <base ref> has no decide_evals_gate_status.py yet, so no tolerance of its own.
    git -C "$mesh_dir" rev-parse -q --verify "$ref^{commit}" >/dev/null || { echo "ERROR: no $ref" >&2; exit 1; }
    gate_src="$(git -C "$mesh_dir" show "$head:$agent_rel/eval/scripts/decide_evals_gate_status.py")"
    tolerance_note="The gate is not on $ref yet (this PR installs it), so the tolerance comes from this head."
    echo "NOTE: $tolerance_note" >&2
  fi
  tolerance="$(sed -n 's/^TOLERANCE = \([0-9][0-9]*\).*/\1/p' <<<"$gate_src")"
  if [ -z "$tolerance" ]; then
    echo "ERROR: no TOLERANCE in $ref's decide_evals_gate_status.py" >&2
    exit 1
  fi
  wt="${MESH_RUN_EVALS_DIR:-$HOME/environment/pmat/alpha-mesh-run-evals}/${head:0:12}"
  [ -d "$wt" ] || git -C "$mesh_dir" worktree add -q --detach "$wt" "$head"
  if [ "$(git -C "$wt" rev-parse HEAD)" != "$head" ]; then
    echo "ERROR: $wt is not at $head" >&2
    exit 1
  fi
  agent="$wt/$agent_rel"
  [ -e "$wt/.env" ] || ln -s "$mesh_dir/.env" "$wt/.env"
  mkdir -p "$HOME/.mesh/eval-runs"
  [ -e "$agent/eval/runs" ] || ln -s "$HOME/.mesh/eval-runs" "$agent/eval/runs"
  (cd "$agent" && uv sync -q)
  run_dir="$agent/eval/runs/$run"
  mkdir -p "$run_dir"
  printf '%s\n' "$baseline_json" > "$run_dir/baseline-${ref##*/}.json"
  echo "Eval gate: ${head:0:7}, run $run, tolerance $tolerance (worktree $wt)" >&2

  # The eval's own exit code says only whether every case passed; the gate decides.
  "$agent/eval/scripts/run_eval.sh" --run "$run" "${eval_args[@]}" || true
  gate=0
  rm -f "$run_dir/gate.md"  # a report left by an earlier gate run on this head must never be posted as this one's
  (cd "$agent" && uv run python eval/scripts/decide_evals_gate_status.py "eval/runs/$run" --baseline "$run_dir/baseline-${ref##*/}.json" \
     --tolerance "$tolerance" --markdown "$run_dir/gate.md" "${check_args[@]}") || gate=$?
  if [ ! -s "$run_dir/gate.md" ]; then
    [ -z "$context" ] || post_status "$repo" "$head" "$context" error "the gate could not score run $run: see its log"
    echo "ERROR: decide_evals_gate_status.py wrote no report (exit $gate)" >&2
    exit 1
  fi
  summary="$(grep -m1 '^runs passed' "$run_dir/gate.md")"
  [ -z "$tolerance_note" ] || printf '%s\n\n%s\n' "$(cat "$run_dir/gate.md")" "_${tolerance_note}_" > "$run_dir/gate.md"
}

remove_worktree() {
  # The run, with its checkpoints, stays in ~/.mesh/eval-runs. Unlink the links first, so nothing follows them.
  rm -f "$agent/eval/runs" "$wt/.env"
  git -C "$mesh_dir" worktree remove --force "$wt"
}

case "${1:-}" in
  --override)
    [ $# -eq 4 ] && [[ "$2" =~ $pr_re ]] && [ "$3" = --reason ] && [ -n "$4" ] || usage
    url="$2" repo="${BASH_REMATCH[1]}" reason="$4"
    head="$(gh pr view "$url" --json headRefOid | jq -r .headRefOid)"
    post_status "$repo" "$head" evals success "override: $reason"
    gh pr comment "$url" --body "**evals overridden** on \`${head:0:7}\` by hand (\`mesh override-evals\`): $reason" >/dev/null
    echo "evals = success (override) on $head." >&2
    exit 0 ;;

  --master)
    [ $# -eq 1 ] || usage
    remote="$(git -C "$mesh_dir" remote get-url origin)"
    [[ "$remote" =~ github\.com[:/]([^/]+/[^/.]+)(\.git)?$ ]] || { echo "ERROR: origin is not on GitHub: $remote" >&2; exit 1; }
    repo="${BASH_REMATCH[1]}"
    git -C "$mesh_dir" fetch -q origin master
    head="$(git -C "$mesh_dir" rev-parse origin/master)"
    context=master-evals-gated
    post_status "$repo" "$head" master-evals-gated pending "mesh run-evals --master is running on ${head:0:7}"
    run_gate "$head" "gate-master-${head:0:7}" origin/master
    cat "$run_dir/gate.md"
    if [ "$gate" -eq 0 ]; then
      post_status "$repo" "$head" master-evals-gated success "mesh run-evals --master passed: $summary"
      remove_worktree
      echo "Master is green: master-evals-gated = success on $head." >&2
      exit 0
    fi
    post_status "$repo" "$head" master-evals-gated failure "mesh run-evals --master failed: $summary"
    # The change to revert: the newest master commit find-ungated-merges marked as an ungated agent change.
    offender="$(gh api "repos/$repo/commits?sha=master&per_page=30" | jq -r '.[].sha' | while read -r sha; do
      gh api "repos/$repo/commits/$sha/status" \
        | jq -e '[.statuses[] | select(.context == "master-evals-gated" and (.description | startswith("ungated")))] | length > 0' \
        >/dev/null && { echo "$sha"; break; }
    done)"
    if [ -z "$offender" ]; then
      remove_worktree
      echo "Master is red and no ungated commit was found in its last 30 commits: revert by hand." >&2
      exit 1
    fi
    branch="eval-revert/${offender:0:7}"
    git -C "$wt" checkout -q -b "$branch"
    if ! git -C "$wt" revert --no-edit "$offender" >/dev/null; then
      git -C "$wt" revert --abort || true
      echo "Master is red; reverting ${offender:0:7} conflicts: revert it by hand on a branch named $branch." >&2
      remove_worktree
      exit 1
    fi
    git -C "$wt" push -q origin "$branch"
    offender_pr="$(gh api "repos/$repo/commits/$offender/pulls" | jq -r '.[0].number // empty')"
    from="${offender:0:7}${offender_pr:+ (PR #$offender_pr)}"
    { echo "## Automatic revert: master is red"
      echo
      echo "**What happened:** \`$from\` changed the review-pull-request agent without a passing eval gate, and"
      echo "\`mesh run-evals --master\` then failed on master's head \`${head:0:7}\`: $summary."
      echo
      echo "**What this PR does:** reverts \`${offender:0:7}\`, and nothing else. Nothing has been merged."
      echo
      echo "**Team lead, next:**"
      echo "1. \`mesh run-evals <this PR's url>\`: the revert must pass the gate too."
      echo "2. \`mesh merge-pr <this PR's url>\`: while master is red, mesh merge-pr merges only this PR, or a gated PR"
      echo "   whose gate passed. Every other merge is refused until then."
      echo
      echo "**Developer of \`$from\`:** redo the change on a new branch, and run the gate before it merges."
      echo
      echo "The gate's report on master:"; echo; cat "$run_dir/gate.md"
    } > "$run_dir/revert-pr.md"
    pr_url="$(gh pr create --repo "$repo" --base master --head "$branch" \
      --title "revert[evals]: reverted ${offender:0:7}, an ungated agent change that fails the eval gate" \
      --body-file "$run_dir/revert-pr.md")"
    remove_worktree
    git -C "$mesh_dir" branch -q -D "$branch" || true
    cat >&2 <<MSG

==== MASTER IS RED: the eval gate failed on master (${head:0:7}) ====
What happened: $from changed the agent without a passing gate; the gate on master now fails: $summary.
What was done: opened the revert PR $pr_url (branch $branch), reverting ${offender:0:7}. Nothing was merged.
Team lead, next:
  1. mesh run-evals $pr_url
  2. mesh merge-pr $pr_url      (until then, every other merge is refused)
Developer of $from: redo the change on a new branch and gate it before merging.
MSG
    exit 1 ;;

  --quick)
    [ $# -eq 2 ] && [[ "$2" =~ $pr_re ]] || usage
    url="$2" repo="${BASH_REMATCH[1]}" number="${BASH_REMATCH[2]}"
    read -r state head base < <(gh pr view "$url" --json state,headRefOid,baseRefName \
      | jq -r '"\(.state) \(.headRefOid) \(.baseRefName)"')
    [ "$state" = OPEN ] || { echo "Not run: the PR is not open (it is $state)." >&2; exit 1; }
    git -C "$mesh_dir" fetch -q origin "$base" "pull/$number/head"
    context=""  # an early warning only: it never posts evals, so it can never let a PR merge
    run_gate "$head" "quick-pr$number-${head:0:7}" "origin/$base" quick
    { echo "**mesh run-evals --quick** on \`${head:0:7}\`: an early warning (k=1), **not the gate**. It catches only a"
      echo "large drop; the full gate runs at merge (\`mesh merge-pr\` offers it)."; echo; cat "$run_dir/gate.md"
    } > "$run_dir/gate-comment.md"
    gh pr comment "$url" --body-file "$run_dir/gate-comment.md" >/dev/null
    cat "$run_dir/gate.md"
    remove_worktree
    exit "$gate" ;;

  -*) usage ;;
esac

[ $# -eq 1 ] && [[ "$1" =~ $pr_re ]] || usage
url="$1"
repo="${BASH_REMATCH[1]}"
number="${BASH_REMATCH[2]}"

read -r state head base < <(gh pr view "$url" --json state,headRefOid,baseRefName \
  | jq -r '"\(.state) \(.headRefOid) \(.baseRefName)"')
if [ "$state" != "OPEN" ]; then
  echo "Not run: the PR is not open (it is $state)." >&2
  exit 1
fi
behind="$(gh api "repos/$repo/compare/$base...$head" | jq -r .behind_by)"
if [ "$behind" != "0" ]; then
  echo "Not run: the branch is $behind commit(s) behind $base, so mesh merge-pr would refuse it anyway." >&2
  echo "Merge $base in, push, then run this again." >&2
  exit 1
fi

git -C "$mesh_dir" fetch -q origin "$base" "pull/$number/head"
context=evals
post_status "$repo" "$head" evals pending "mesh run-evals is running on ${head:0:7}"
run_gate "$head" "gate-pr$number-${head:0:7}" "origin/$base"  # master's baseline and tolerance, never the PR's

if [ "$gate" -eq 0 ]; then
  post_status "$repo" "$head" evals success "$summary"
else
  post_status "$repo" "$head" evals failure "$summary"
fi
{ echo "**mesh run-evals** on \`${head:0:7}\` (run \`gate-pr$number-${head:0:7}\`)"; echo; cat "$run_dir/gate.md"; } \
  > "$run_dir/gate-comment.md"
gh pr comment "$url" --body-file "$run_dir/gate-comment.md" >/dev/null
cat "$run_dir/gate.md"
remove_worktree
if [ "$gate" -eq 0 ]; then
  echo "Gate passed: evals = success on $head." >&2
else
  echo "Gate failed: evals = failure on $head." >&2
fi
exit "$gate"
