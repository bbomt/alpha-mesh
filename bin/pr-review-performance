#!/usr/bin/env bash
# alpha-mesh/bin/pr-review-performance
# Thin proxy → inner bash entry point.

set -euo pipefail

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
MESH_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
INNER_BIN="$MESH_DIR/agents/pr-review-performance/pr_review_performance/bin/pr-review-performance"

exec bash "$INNER_BIN" "$@"
