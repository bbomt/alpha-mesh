#!/usr/bin/env bash
# alpha-mesh/bin/dream
# End-of-session memory consolidation.
# Reads: Claude Code session logs (~/.claude/projects/*.jsonl)
# Writes: .mesh/MEMORY.md in each repo worked in (synthesis rewrite)
#         ~/.mesh/MEMORY.md for cross-repo learnings
#
# Usage:
#   dream              # process today's sessions (default)
#   dream --dry-run    # print extracted content, write nothing
#   dream --days 3     # process sessions from last 3 days
#   dream --days 5     # process sessions from last 5 days

set -euo pipefail

# Resolve actual script path (handles symlinks in ~/bin/)
SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
MESH_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
LIB_DIR="$MESH_DIR/bin/lib"
CLAUDE_PROJECTS="$HOME/.claude/projects"
ENV_FILE="$MESH_DIR/.env"
LOCAL_SETTINGS="$MESH_DIR/.claude/settings.json"

# Load shared library
# shellcheck source=bin/lib/repo
source "$LIB_DIR/repo"

# Load .env if it exists
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# ─── Parse args ──────────────────────────────────────────────────────────────
DRY_RUN=false
DAYS_BACK=0  # 0 = today only

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --days) DAYS_BACK="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

DATE=$(date +%Y-%m-%d)
TIMESTAMP=$(date +%Y-%m-%d-%H%M)

# Determine cutoff date for session file selection
if [[ "$DAYS_BACK" -gt 0 ]]; then
  if date -u -d "$DAYS_BACK days ago" +%Y-%m-%d &>/dev/null; then
    CUTOFF=$(date -u -d "$DAYS_BACK days ago" +%Y-%m-%d)
  else
    CUTOFF=$(date -u -v-${DAYS_BACK}d +%Y-%m-%d)
  fi
  WINDOW_LABEL="last $DAYS_BACK days"
else
  # Use local date for cutoff to match file modification times
  CUTOFF=$(date +%Y-%m-%d)
  WINDOW_LABEL="today"
fi

echo "=== PMAT Dream: $DATE ==="
echo "Window: $WINDOW_LABEL (since $CUTOFF)"
echo ""

# ─── 1. Find and extract JSONL session files ─────────────────────────────────
if [[ ! -d "$CLAUDE_PROJECTS" ]]; then
  echo "No Claude Code projects directory found at $CLAUDE_PROJECTS"
  echo "Has Claude Code been used in this environment?"
  exit 0
fi

echo "Scanning $CLAUDE_PROJECTS ..."

# Count files first for progress indication
TOTAL_FILES=$(find "$CLAUDE_PROJECTS" -name "*.jsonl" 2>/dev/null | wc -l)
echo "  Found $TOTAL_FILES jsonl file(s) to scan"
echo ""

# Write Python script to temp file and execute it
EXTRACT_SCRIPT=$(mktemp /tmp/dream-extract-XXXXXX.py)
cat > "$EXTRACT_SCRIPT" <<'PYTHON_SCRIPT'
import sys, json, os, re
from collections import defaultdict, Counter

projects_dir = sys.argv[1]
cutoff = sys.argv[2]

repo_data = defaultdict(lambda: {"content_lines": [], "dates": set()})
file_count = 0
processed = 0

for root, dirs, files in os.walk(projects_dir):
    for fname in files:
        if not fname.endswith('.jsonl'):
            continue
        fpath = os.path.join(root, fname)
        processed += 1
        if processed % 10 == 0:
            print(f"  Processed {processed} files...", flush=True, file=sys.stderr)

        try:
            mtime = os.path.getmtime(fpath)
            import time
            # Use localtime to match how files were written
            fdate = time.strftime('%Y-%m-%d', time.localtime(mtime))
        except OSError:
            continue

        if fdate < cutoff:
            continue

        file_count += 1
        cwds = set()
        messages = []

        try:
            with open(fpath) as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue

                    cwd = obj.get('cwd')
                    if cwd:
                        cwds.add(cwd)

                    msg = obj.get('message', {})
                    if 'role' not in msg:
                        msg = obj
                    role = msg.get('role', '')
                    content = msg.get('content', '')

                    if role == 'assistant' and isinstance(content, list):
                        for block in content:
                            if isinstance(block, dict) and block.get('type') == 'text':
                                text = block.get('text', '').strip()
                                if text and len(text) > 100:
                                    messages.append(f"[assistant] {text[:800]}")

                    elif role == 'user':
                        text = ''
                        if isinstance(content, str):
                            text = content.strip()
                        elif isinstance(content, list):
                            for block in content:
                                if isinstance(block, dict) and block.get('type') == 'text':
                                    text = block.get('text', '').strip()
                                    break
                        if text and len(text) > 20 and not text.startswith('/'):
                            messages.append(f"[user] {text[:300]}")

            combined = messages
            extracted = combined[-30:]  # Keep last 30 messages only
            if not extracted:
                continue

            # Determine repo path from most common cwd
            if cwds:
                repo_path = Counter(cwds).most_common(1)[0][0]
            else:
                proj_dir_name = os.path.basename(root)
                decoded = proj_dir_name.lstrip('-')
                home = os.path.expanduser('~')
                candidate = os.path.join(home, decoded.replace('-', '/'))
                repo_path = candidate if os.path.isdir(candidate) else proj_dir_name

            content_str = '\n'.join(extracted)
            repo_data[repo_path]["content_lines"].append(
                f"--- Session: {os.path.basename(root)} ({fdate}) ---\n{content_str}"
            )
            repo_data[repo_path]["dates"].add(fdate)

        except OSError:
            continue

print(f"  Done scanning {processed} files, found {file_count} in date range", flush=True, file=sys.stderr)

result = {"repos": {}, "file_count": file_count}
for repo_path, data in repo_data.items():
    repo_name = os.path.basename(repo_path)
    print(f"  -> Found {len(data['content_lines'])} sessions from {repo_name}", flush=True, file=sys.stderr)
    result["repos"][repo_path] = {
        "content": '\n\n'.join(data["content_lines"]),
        "dates": sorted(data["dates"])
    }

# Output JSON only to stdout
print(json.dumps(result))
PYTHON_SCRIPT

# Run the extraction script
PYTHON_OUT=$(timeout 60 python3 "$EXTRACT_SCRIPT" "$CLAUDE_PROJECTS" "$CUTOFF" 2>&1)
rm -f "$EXTRACT_SCRIPT"

# Extract stdout (JSON) - it's the last non-progress line
EXTRACTED_DATA=$(echo "$PYTHON_OUT" | grep -vE "^  " | tail -1)

# Check for errors (but ignore extraction warnings)
if [[ -z "$EXTRACTED_DATA" ]] || echo "$EXTRACTED_DATA" | grep -qi "traceback\|timeout"; then
  echo "  Warning: Extraction issue, output may be incomplete"
fi

FILE_COUNT=$(echo "$EXTRACTED_DATA" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('file_count',0))" 2>/dev/null || echo "0")

if [[ "$FILE_COUNT" -eq 0 ]]; then
  echo "No session files found modified since $CUTOFF."
  echo "dream complete — nothing to process."
  exit 0
fi

echo "Found $FILE_COUNT session file(s)"
echo ""

if [[ "$DRY_RUN" == "true" ]]; then
  echo "=== DRY RUN — printing extracted learnings, writing nothing ==="
  echo ""
  echo "$EXTRACTED_DATA" | python3 -c "
import json, sys
data = json.load(sys.stdin).get('repos', {})
if not data:
    print('  No repo content extracted.')
else:
    for i, (repo, info) in enumerate(sorted(data.items()), 1):
        dates_str = ', '.join(info['dates'])
        content_preview = info['content'][:800]
        print(f'[Repo {i}] {repo}')
        print(f'  Sessions dates: {dates_str}')
        print(f'  Content ({len(info[\"content\"])} chars):')
        print(f'  {content_preview}')
        print()
"
  echo "=== DRY RUN COMPLETE — no files written ==="
  exit 0
fi

# ─── 2. Read active model configuration ──────────────────────────────────────
echo "Reading active model configuration..."

if [[ ! -f "$LOCAL_SETTINGS" ]]; then
  echo "ERROR: No local settings found at $LOCAL_SETTINGS."
  echo "Run 'mesh model use <profile>' to configure a model first."
  exit 1
fi

MODEL=$(jq -r '.env.ANTHROPIC_MODEL // ""' "$LOCAL_SETTINGS")
BASE_URL=$(jq -r '.env.ANTHROPIC_BASE_URL // ""' "$LOCAL_SETTINGS")
TOKEN=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // .env.ANTHROPIC_API_KEY // ""' "$LOCAL_SETTINGS")

if [[ -z "$MODEL" ]] || [[ "$MODEL" == "null" ]]; then
  echo "ERROR: No ANTHROPIC_MODEL set in $LOCAL_SETTINGS."
  echo "Run 'mesh model use <profile>' to configure a model."
  exit 1
fi

if [[ -z "$TOKEN" ]] || [[ "$TOKEN" == "REPLACE_WITH_"* ]]; then
  echo "ERROR: Auth token not configured in $LOCAL_SETTINGS."
  echo "Check your .env file or run 'mesh model use <profile>' to configure credentials."
  exit 1
fi

if [[ -z "$BASE_URL" ]] || [[ "$BASE_URL" == "null" ]]; then
  BASE_URL="https://api.anthropic.com"
fi

echo "  Model: $MODEL (${BASE_URL})"
echo ""

API_URL="${BASE_URL%/}/v1/messages"

# ─── Helper: call LLM with the active model ──────────────────────────────────
call_llm() {
  local prompt_text="$1"
  local max_tokens="${2:-2000}"

  local payload
  payload=$(python3 -c "
import json, sys
prompt = sys.stdin.read()
print(json.dumps({
    'model': '${MODEL}',
    'max_tokens': ${max_tokens},
    'messages': [{'role': 'user', 'content': prompt}]
}))
" <<< "$prompt_text")

  curl -s -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $TOKEN" \
    -d "$payload" 2>/dev/null || echo ""
}

# ─── Helper: extract text from LLM response (Anthropic or OpenAI format) ─────
extract_response_text() {
  python3 -c '
import json, sys
try:
    r = json.load(sys.stdin)
    if "content" in r and isinstance(r["content"], list):
        for block in r["content"]:
            if isinstance(block, dict) and block.get("type") == "text":
                print(block["text"])
                sys.exit(0)
    elif "choices" in r:
        print(r["choices"][0]["message"]["content"])
        sys.exit(0)
    else:
        print(json.dumps(r))
except Exception:
    pass
' 2>/dev/null || echo ""
}

# ─── Write repo summary data to tmp file to avoid subshell issues ────────────
SUMMARY_FILE=$(mktemp /tmp/dream-summary-XXXXXX)
CROSS_FILE=$(mktemp /tmp/dream-cross-XXXXXX)
echo -n > "$SUMMARY_FILE"
echo -n > "$CROSS_FILE"

# Export functions and vars for subshells
export -f call_llm extract_response_text
export MODEL BASE_URL TOKEN API_URL MESH_DIR DATE

# ─── 3. Process each repo ────────────────────────────────────────────────────
echo "Processing repos..."
echo ""

# Extract repo list into a tmp file for iteration without pipes
REPO_LIST_FILE=$(mktemp /tmp/dream-repos-XXXXXX)
echo "$EXTRACTED_DATA" | python3 -c '
import json, sys
data = json.load(sys.stdin).get("repos", {})
for repo, info in sorted(data.items()):
    dates = ",".join(info["dates"])
    # write: repo_path|dates|content (content base64-encoded to avoid pipe issues)
    import base64
    content_b64 = base64.b64encode(info["content"].encode()).decode()
    print(f"{repo}|{dates}|{content_b64}")
' > "$REPO_LIST_FILE" 2>/dev/null

TOTAL_REPOS=$(wc -l < "$REPO_LIST_FILE")
CURRENT_REPO=0
ALL_OK=true

while IFS='|' read -r repo_path dates content_b64; do
  CURRENT_REPO=$((CURRENT_REPO + 1))
  echo "[$CURRENT_REPO/$TOTAL_REPOS] --- Processing: $(basename "$repo_path") ($dates) ---"

  # Decode base64 content
  session_content=$(echo "$content_b64" | python3 -c "import sys,base64; print(base64.b64decode(sys.stdin.read()).decode())")

  # ── Step A: Extract learnings from raw session content ──
  echo -n "  Extracting learnings... "
  SYSTEM_MODEL_NAME="${MODEL##*/}"
  SYSTEM_MODEL_NAME="${SYSTEM_MODEL_NAME%%-*}"

  extract_prompt="You are extracting learnings from a software development session.
Be specific and concrete. Do not invent anything not in the source.

## Session content from $(basename "$repo_path")
${session_content}

Return only a markdown snippet (no preamble) with these sections:

## ${DATE} — $(basename "$repo_path")
### What worked
### What failed
### Patterns noticed
### Preferences observed
### Gotchas"

  extraction_result=$(call_llm "$extract_prompt" 2000)

  if [[ -z "$extraction_result" ]]; then
    echo "⚠ LLM unavailable"
    new_learnings="$session_content"
    llm_success=false
  else
    echo "✓"
    new_learnings=$(echo "$extraction_result" | extract_response_text)
    if [[ -z "$new_learnings" ]]; then
      new_learnings="$session_content"
    fi
    llm_success=true
  fi

  # ── Step B: Read existing .mesh/MEMORY.md ──
  mesh_dir="$repo_path/.mesh"
  memory_file="$mesh_dir/MEMORY.md"
  existing_memory=""
  mkdir -p "$mesh_dir"
  if [[ -f "$memory_file" ]]; then
    existing_memory=$(cat "$memory_file")
  fi

  # ── Step C: Synthesis rewrite (merge existing + new) ──
  if $llm_success && [[ -n "$existing_memory" ]]; then
    echo -n "  Synthesizing with existing memory... "

    sys_prompt="You are maintaining a memory file for an AI coding agent.
Below is the existing memory and new learnings from recent sessions.
Produce an updated memory file that:
- Incorporates the new learnings
- Removes duplicates (keep the best single statement of each point)
- Removes anything superseded by newer learnings
- Keeps the file concise — every line must earn its place
- Hard limit: 200 lines

## Existing memory
${existing_memory}

## New learnings
${new_learnings}

Return only the updated memory file content, no preamble.
Keep the same section headings as the existing memory where present.

If any learning applies across multiple repos or to the project as a whole,
prefix it with **[CROSS-REPO]** so it can be collected for the cross-repo memory file."

    synthesis_result=$(call_llm "$sys_prompt" 3000)

    if [[ -n "$synthesis_result" ]]; then
      updated_memory=$(echo "$synthesis_result" | extract_response_text)
      if [[ -n "$updated_memory" ]]; then
        echo "✓"
        # Extract cross-repo items (avoid pipefail with process substitution)
        while IFS= read -r cross_line; do
          echo "## $DATE — $(basename "$repo_path")" >> "$CROSS_FILE"
          echo "$cross_line" >> "$CROSS_FILE"
          echo "" >> "$CROSS_FILE"
        done < <(echo "$updated_memory" | grep '\[CROSS-REPO\]' || true)

        line_count=$(echo "$updated_memory" | wc -l)
        if [[ "$line_count" -gt 200 ]]; then
          echo "  ⚠ Warning: Memory file has $line_count lines (suggested max: 200)"
        fi

        echo "$updated_memory" > "$memory_file"
        echo "$(basename "$repo_path")|written" >> "$SUMMARY_FILE"
        continue
      fi
    fi

    # Fallback: append to existing
    echo "⚠ Synthesis failed — appending raw learnings"
    {
      echo ""
      echo "## $DATE"
      echo "$new_learnings"
    } >> "$memory_file"
    echo "$(basename "$repo_path")|append-fallback" >> "$SUMMARY_FILE"

  elif $llm_success; then
    # First run — no existing memory
    echo "  Creating new memory file... ✓"
    echo "$new_learnings" > "$memory_file"
    echo "$(basename "$repo_path")|new" >> "$SUMMARY_FILE"

  else
    # LLM down — raw content fallback
    echo -n "  Writing raw session content (LLM unavailable)... "
    if [[ -f "$memory_file" ]]; then
      {
        echo ""
        echo "## $DATE — Raw session content (LLM unavailable)"
        echo "$new_learnings"
      } >> "$memory_file"
    else
      {
        echo "# Memory: $(basename "$repo_path")"
        echo ""
        echo "## $DATE — Raw session content (LLM unavailable)"
        echo "$new_learnings"
      } > "$memory_file"
    fi
    echo "✓"
    echo "$(basename "$repo_path")|raw-fallback" >> "$SUMMARY_FILE"
  fi

done < "$REPO_LIST_FILE"

rm -f "$REPO_LIST_FILE"

# ─── 4. Cross-repo synthesis to ~/.mesh/MEMORY.md ────────────────────────────
CROSS_CONTENT=$(cat "$CROSS_FILE" 2>/dev/null || echo "")
rm -f "$CROSS_FILE"

if [[ -n "$CROSS_CONTENT" ]]; then
  echo ""
  echo "--- Cross-repo learnings ---"
  echo "  Processing cross-repo items..."

  mkdir -p "$HOME/.mesh"
  LOCAL_CROSS_FILE="$HOME/.mesh/MEMORY.md"
  LOCAL_CROSS_EXISTING=""
  [[ -f "$LOCAL_CROSS_FILE" ]] && LOCAL_CROSS_EXISTING=$(cat "$LOCAL_CROSS_FILE")

  echo -n "  Running cross-repo synthesis... "

  cross_sys_prompt="You are maintaining a cross-repo memory file for an AI coding agent.
This file contains learnings that apply across multiple repositories.

## Existing memory
${LOCAL_CROSS_EXISTING:-}

## New cross-repo learnings
${CROSS_CONTENT}

Return only the updated memory file content, no preamble.
Keep the same section headings. Max 200 lines. Deduplicate."

  cross_result=$(call_llm "$cross_sys_prompt" 3000)

  if [[ -n "$cross_result" ]]; then
    cross_updated=$(echo "$cross_result" | extract_response_text)
    if [[ -n "$cross_updated" ]]; then
      echo "$cross_updated" > "$LOCAL_CROSS_FILE"
      echo "✓"
    else
      echo "⚠ Fallback — appending raw"
      {
        echo ""
        echo "## $DATE"
        echo "$CROSS_CONTENT"
      } >> "$LOCAL_CROSS_FILE"
    fi
  else
    echo "⚠ LLM unavailable — writing raw"
    if [[ -f "$LOCAL_CROSS_FILE" ]]; then
      {
        echo ""
        echo "## $DATE"
        echo "$CROSS_CONTENT"
      } >> "$LOCAL_CROSS_FILE"
    else
      {
        echo "# Cross-Repo Memory"
        echo ""
        echo "## $DATE"
        echo "$CROSS_CONTENT"
      } > "$LOCAL_CROSS_FILE"
    fi
  fi
fi

# ─── 5. Print summary ────────────────────────────────────────────────────────
echo ""
echo "dream complete — $DATE $TIMESTAMP"

if [[ -s "$SUMMARY_FILE" ]]; then
  while IFS='|' read -r repo_name status; do
    echo "  $repo_name: .mesh/MEMORY.md ($status)"
  done < "$SUMMARY_FILE"

  if [[ -f "$HOME/.mesh/MEMORY.md" ]]; then
    echo "  cross-repo: ~/.mesh/MEMORY.md (✓ written)"
  fi
else
  echo "  No repos processed."
fi

rm -f "$SUMMARY_FILE"

echo ""
echo "Next: run 'mesh test-alpha-mesh' to run tests"