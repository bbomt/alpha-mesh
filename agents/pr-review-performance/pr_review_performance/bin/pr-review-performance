#!/usr/bin/env bash
# agents/pr-review-performance/pr_review_performance/bin/pr-review-performance
# Actual bash runner — loads .env, tee logs, calls Python.

set -euo pipefail

SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
AGENT_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
MESH_DIR="$(cd "$AGENT_DIR/../../.." && pwd)"
ENV_FILE="$MESH_DIR/.env"

# Load .env for CODE_REVIEW_* vars
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# Tee all output to the log file
LOG_DIR="${HOME}/environment/logs/ai/claude"
LOG_FILE="${LOG_DIR}/alpha-mesh-pr-review-performance-$(date +%Y-%m-%d).log"
mkdir -p "$LOG_DIR"

cd "$AGENT_DIR"

exec uv run python -m pr_review_performance "$@" 2>&1 | tee "$LOG_FILE"
