{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "review-pull-request eval case",
  "description": "One eval case (eval/README.md). expected holds properties a good review has, never expected text.",
  "type": "object",
  "required": ["case_id", "repo", "pr_number", "label", "category", "expected", "notes"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "base_sha": {"type": ["string", "null"]},
    "head_sha": {"type": ["string", "null"]},
    "raised_sha": {"type": ["string", "null"]},
    "fix_sha": {"type": ["string", "null"]},
    "label": {"enum": ["false_positive", "real_issue"]},
    "label_by": {"type": "string"},
    "label_date": {"type": "string"},
    "label_reason": {"type": ["string", "null"]},
    "category": {"enum": ["mined", "logic", "security", "style_only", "refactor", "concurrency", "improvable",
                          "degenerate"]},
    "expected": {
      "type": "object",
      "anyOf": [{"required": ["must_flag"]}, {"required": ["must_not_reraise"]}],
      "additionalProperties": false,
      "properties": {
        "must_flag": {"type": "boolean"},
        "must_not_reraise": {"type": "boolean"},
        "flag_file": {"type": "string", "minLength": 1},
        "min_severity": {"enum": ["high", "medium", "low"]},
        "must_mention_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "max_comments": {"type": "integer", "minimum": 0}
      }
    },
    "notes": {"type": "string"}
  }
}
