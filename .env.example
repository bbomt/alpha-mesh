# alpha-mesh tokens — copy this to .env and fill in your actual keys
# NEVER commit .env to GitHub. Keys go here only, never in config/models.json.

ALPHA_MESH_MINIMAX_TOKEN=your_minimax_key_here
ALPHA_MESH_OPENROUTER_TOKEN=your_openrouter_key_here
ALPHA_MESH_ANTHROPIC_TOKEN=your_anthropic_key_here

# CODE REVIEW — LLM credentials

# The model is not set here: it is [model] review in agents/review-pull-request/review_config.toml, committed,
# so a model change is a PR, and the eval gate runs the same model the reviews use (PMAT-312).
CODE_REVIEW_URL=https://openrouter.ai/api
CODE_REVIEW_TOKEN=your-token-here

# JUDGE — the eval's LLM judge (PMAT-311): a different model family from the review model

EVAL_JUDGE_MODEL=your-judge-model-here
EVAL_JUDGE_URL=https://openrouter.ai/api
EVAL_JUDGE_TOKEN=your-token-here
# Judge host (PMAT-347, 24 Nov 2026): optional, OpenRouter only, the one host the judge may use (no fallback).
# Minimax stopped hosting minimax/minimax-m3.1-flash. Full judging trials on PR #67's 195 stored reviews:
#   1. makora/fp4 (default): 0 judge errors, best means (correctness 3.19, coverage 3.95), $0.50 per run
#   2. inferact-vllm/nvfp4 (fallback if Makora is down): 0 errors, 3.06 / 3.92, $0.76 per run
#   3. digitalocean (third): 0 errors, 3.06 / 3.89, $0.75 per run
#   Not inference-net (malformed replies, reports no reasoning).
EVAL_JUDGE_PROVIDER=makora/fp4

# SILVER — the model that writes the judge's silver calibration labels (PMAT-326), on its own host and key (the judge's may differ)
SILVER_CALIBRATION_MODEL=openai/gpt-6.1-terra
SILVER_CALIBRATION_URL=https://openrouter.ai/api
SILVER_CALIBRATION_TOKEN=your-token-here

# Checkpoint store for resumable reviews (optional; defaults suit the dev EC2, AWS credentials via SSO dev-EC2)
# DEPLOY_ENV=dev
# AWS_REGION=<your region>   (unset: the region of your AWS profile)
# ALPHA_MESH_REVIEW_PULL_REQ_CHECKPOINT_TABLE=
# ALPHA_MESH_REVIEW_PULL_REQ_CHECKPOINT_BUCKET=

# The account agents/review-pull-request/scripts/deploy-dev-from-ec2.sh checks your credentials against;
# the deploy stops without it (an AWS_ACCOUNT_ID in the environment wins, e.g. in CI)
AWS_ACCOUNT_ID=<your 12-digit AWS account ID>
