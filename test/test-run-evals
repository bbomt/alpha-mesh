#!/usr/bin/env bash
# alpha-mesh/test/test-run-evals
# Runs `mesh run-evals` against stand-in `gh`, `git` and `uv` and a stand-in eval run, and checks that it posts the
# gate's verdict as the `evals` status on the PR's head commit (pending first), comments the report, scores with
# master's baseline and tolerance, refuses a stale branch, and leaves the eval runs folder alone (PMAT-312). Also
# `mesh merge-pr --status` (the merge status report), `mesh override-evals` (evals = success by hand) and
# `--master` (master-evals-gated on master's head, and on a failure the PR that reverts the ungated commit).

set -euo pipefail

MESH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
URL="https://github.com/o/r/pull/15"
HEAD_SHA="abc1234def5678abc1234def5678abc1234def56"

mkdir -p "$WORK/bin" "$WORK/home/.mesh/eval-runs/keep-me"
cat > "$WORK/bin/gh" <<'EOF'
#!/usr/bin/env bash
echo "gh $*" >> "$STUB_LOG"
case "$1 $2" in
  "pr view") printf '{"state":"OPEN","headRefOid":"%s","baseRefName":"master"}\n' "$STUB_HEAD" ;;
  "api repos/o/r/compare/master...$STUB_HEAD") printf '{"behind_by":%s}\n' "$STUB_BEHIND" ;;
  "api repos/o/r/statuses/$STUB_HEAD") ;;
  "pr comment")  # pr comment <url> --body-file <file> | --body <text>
    if [ "$4" = --body-file ]; then cp "$5" "$STUB_COMMENT"; else printf '%s\n' "$5" > "$STUB_COMMENT"; fi ;;
  "pr diff") printf '%s\n' "agents/review-pull-request/src/review_pull_request/stage2.py" ;;
  "api repos/o/r/commits/master/status") printf '{"statuses":[]}\n' ;;
  "api repos/o/r/commits/$STUB_HEAD/status") printf '{"statuses":[]}\n' ;;
  "api repos/o/r/pulls/15/commits?per_page=100") printf '[{"sha":"%s"}]\n' "$STUB_HEAD" ;;
  "api repos/o/r/commits?sha=master&per_page=30") printf '[{"sha":"%s"},{"sha":"0ff1ce0ff1ce"}]\n' "$STUB_HEAD" ;;
  "api repos/o/r/commits/0ff1ce0ff1ce/status")
    printf '{"statuses":[{"context":"master-evals-gated","state":"failure","description":"ungated agent change: PR #3"}]}\n' ;;
  "pr create") echo "https://github.com/o/r/pull/99" ;;
  "api repos/o/r/commits/0ff1ce0ff1ce/pulls") printf '[{"number":3}]\n' ;;
  *) echo "unexpected gh call: $*" >&2; exit 9 ;;
esac
EOF
cat > "$WORK/bin/git" <<'EOF'
#!/usr/bin/env bash
shift 2  # -C <dir>
echo "git $*" >> "$STUB_LOG"
case "$1" in
  fetch) ;;
  show)
    case "$2" in
      *baseline.json) [ -z "${STUB_NO_BASELINE:-}" ] || exit 128; echo '{"model": "master-baseline"}' ;;
      origin/master:*decide_evals_gate_status.py)  # STUB_NO_GATE: master predates the gate (the PR that installs it)
        [ -z "${STUB_NO_GATE:-}" ] || exit 128; printf '"""doc"""\nTOLERANCE = 7  # runs\n' ;;
      *decide_evals_gate_status.py) printf '"""doc"""\nTOLERANCE = 9  # runs\n' ;;
    esac ;;
  rev-parse) echo "$STUB_HEAD" ;;
  remote) echo "https://github.com/o/r.git" ;;
  checkout|push|branch) ;;
  revert) [ "${STUB_REVERT:-ok}" = ok ] || exit 1 ;;
  worktree)
    if [ "$2" = add ]; then  # worktree add -q --detach <dir> <sha>
      mkdir -p "$5/agents/review-pull-request/eval/scripts"
      printf '#!/usr/bin/env bash\necho "run_eval $*" >> "$STUB_LOG"\nexit 100\n' \
        > "$5/agents/review-pull-request/eval/scripts/run_eval.sh"
      chmod +x "$5/agents/review-pull-request/eval/scripts/run_eval.sh"
    else  # worktree remove --force <dir>
      rm -rf "$4"
    fi ;;
  *) echo "unexpected git call: $*" >&2; exit 9 ;;
esac
EOF
cat > "$WORK/bin/uv" <<'EOF'
#!/usr/bin/env bash
echo "uv $*" >> "$STUB_LOG"
[ "$1" = sync ] && exit 0
# uv run python eval/scripts/decide_evals_gate_status.py <run> --baseline <f> --tolerance <t> --markdown <md>
cp "$6" "$STUB_BASELINE_SEEN"
case "$STUB_GATE" in
  pass) echo "runs passed 142/195 · baseline 140/195 · needs at least 133/195 (tolerance 7) · change +2" > "${10}"; exit 0 ;;
  fail) echo "runs passed 90/195 · baseline 140/195 · needs at least 133/195 (tolerance 7) · change -50" > "${10}"; exit 1 ;;
  crash) exit 2 ;;
  *) echo "unexpected STUB_GATE: $STUB_GATE" >&2; exit 99 ;;
esac
EOF
chmod +x "$WORK/bin/"*

fails=0
run() {  # run <name> <behind> <gate> <want exit> <want status sequence> <want comment yes|no>
  local name="$1" out code statuses commented=no
  : > "$WORK/log"; rm -f "$WORK/comment" "$WORK/baseline-seen"
  set +e
  out="$(PATH="$WORK/bin:$PATH" HOME="$WORK/home" MESH_RUN_EVALS_DIR="$WORK/gates" STUB_LOG="$WORK/log" \
         STUB_HEAD="$HEAD_SHA" STUB_BEHIND="$2" STUB_GATE="$3" STUB_COMMENT="$WORK/comment" \
         STUB_BASELINE_SEEN="$WORK/baseline-seen" "$MESH_DIR/bin/mesh" run-evals "$URL" 2>&1)"
  code=$?
  set -e
  statuses="$(grep -o 'state=[a-z]*' "$WORK/log" | cut -d= -f2 | paste -sd, - || true)"
  [ -f "$WORK/comment" ] && commented=yes
  local bad=""
  [ "$code" -eq "$4" ] || bad="exit $code, want $4"
  [ "$statuses" = "$5" ] || bad="$bad; statuses '$statuses', want '$5'"
  [ "$commented" = "$6" ] || bad="$bad; comment $commented, want $6"
  [ -d "$WORK/home/.mesh/eval-runs/keep-me" ] || bad="$bad; the eval runs folder was touched"
  if [ -n "$bad" ]; then
    echo "  FAIL: $name: $bad"; echo "$out" | sed 's/^/    /'; sed 's/^/    log: /' "$WORK/log"
    fails=$((fails + 1)); return 1
  fi
  echo "  PASS: $name"
}

echo "=== run-evals tests ==="
run "a stale branch is refused before any run or status" 3 pass 1 "" no || true
if grep -q "run_eval" "$WORK/log"; then echo "  FAIL: a stale branch must not start the eval"; fails=$((fails + 1)); fi

if run "a passing run posts pending, then success, and comments the report" 0 pass 0 "pending,success" yes; then
  grep -q 'description=runs passed 142/195 · baseline 140/195 · needs at least 133/195 (tolerance 7) · change +2' "$WORK/log" \
    || { echo "  FAIL: the success status lacks the count"; fails=$((fails + 1)); }
  grep -q -- "--tolerance 7 " "$WORK/log" || { echo "  FAIL: not scored with master's tolerance"; fails=$((fails + 1)); }
  grep -q '"master-baseline"' "$WORK/baseline-seen" \
    || { echo "  FAIL: not scored against master's baseline"; fails=$((fails + 1)); }
  grep -q -- "--run gate-pr15-abc1234 --judge-repeats all" "$WORK/log" \
    || { echo "  FAIL: the eval did not judge every repeat"; fails=$((fails + 1)); }
  grep -q "abc1234" "$WORK/comment" || { echo "  FAIL: the comment does not name the commit"; fails=$((fails + 1)); }
  [ ! -e "$WORK/gates/${HEAD_SHA:0:12}" ] || { echo "  FAIL: the worktree was left behind"; fails=$((fails + 1)); }
fi
run "a failing run posts failure and comments the report" 0 fail 1 "pending,failure" yes || true
run "a run the gate cannot score posts error, no comment" 0 crash 1 "pending,error" no || true
STUB_NO_BASELINE=1 run "a run that stops before a verdict posts error, never leaves pending" 0 pass 128 "pending,error" no || true
if STUB_NO_GATE=1 run "before the gate is on master, it scores with the head's tolerance" 0 pass 0 "pending,success" yes; then
  grep -q -- "--tolerance 9 " "$WORK/log" || { echo "  FAIL: not scored with the head's tolerance"; fails=$((fails + 1)); }
  grep -q "not on origin/master yet" "$WORK/comment" \
    || { echo "  FAIL: the comment does not say the tolerance came from the head"; fails=$((fails + 1)); }
fi


# --master: the gate on master's head posts master-evals-gated; a failure opens the revert PR of the ungated commit.
master() {  # master <name> <gate> <want exit> <want statuses> <want revert PR yes|no>; leaves the output in $out
  local code statuses pr=no
  : > "$WORK/log"
  set +e
  out="$(PATH="$WORK/bin:$PATH" HOME="$WORK/home" MESH_RUN_EVALS_DIR="$WORK/gates" STUB_LOG="$WORK/log" \
         STUB_HEAD="$HEAD_SHA" STUB_GATE="$2" STUB_COMMENT="$WORK/comment" STUB_BASELINE_SEEN="$WORK/baseline-seen" \
         "$MESH_DIR/bin/mesh" run-evals --master 2>&1)"
  code=$?
  set -e
  statuses="$(grep 'context=master-evals-gated' "$WORK/log" | grep -o 'state=[a-z]*' | cut -d= -f2 | paste -sd, - || true)"
  grep -q "^gh pr create" "$WORK/log" && pr=yes
  if [ "$code" -ne "$3" ] || [ "$statuses" != "$4" ] || [ "$pr" != "$5" ]; then
    echo "  FAIL: $1: exit $code, master-evals-gated '$statuses', revert PR $pr"; echo "$out" | sed 's/^/    /'
    fails=$((fails + 1)); return 1
  fi
  echo "  PASS: $1"
}
master "a passing gate on master turns it green and opens no PR" pass 0 "pending,success" no || true
if master "a failing gate on master stays red and opens the revert PR" fail 1 "pending,failure" yes; then
  grep -q "git revert --no-edit 0ff1ce0ff1ce" "$WORK/log" || { echo "  FAIL: did not revert the ungated commit"; fails=$((fails + 1)); }
  grep -q "MASTER IS RED" <<<"$out" && grep -q "Team lead, next:" <<<"$out" && grep -q "mesh merge-pr https://github.com/o/r/pull/99" <<<"$out" \
    || { echo "  FAIL: the console does not say plainly what happened and what the team lead does next"; fails=$((fails + 1)); }
  grep -q "git checkout -q -b eval-revert/0ff1ce0" "$WORK/log" \
    || { echo "  FAIL: the revert branch is not eval-revert/<sha>"; fails=$((fails + 1)); }
fi

# override-evals: evals = success by hand, recorded on the PR.
: > "$WORK/log"; rm -f "$WORK/comment"
PATH="$WORK/bin:$PATH" STUB_LOG="$WORK/log" STUB_HEAD="$HEAD_SHA" STUB_COMMENT="$WORK/comment" \
  "$MESH_DIR/bin/mesh" override-evals "$URL" --reason "judge outage, scores read by hand" >/dev/null 2>&1
if grep -q "state=success -f context=evals -f description=override: judge outage" "$WORK/log" \
   && grep -q "judge outage" "$WORK/comment"; then
  echo "  PASS: override-evals posts evals = success with the reason and records it on the PR"
else
  echo "  FAIL: override-evals"; sed 's/^/    log: /' "$WORK/log"; fails=$((fails + 1))
fi
if PATH="$WORK/bin:$PATH" STUB_LOG="$WORK/log" "$MESH_DIR/bin/mesh" override-evals "$URL" >/dev/null 2>&1; then
  echo "  FAIL: override-evals without a reason must be refused"; fails=$((fails + 1))
else
  echo "  PASS: override-evals without a reason is refused"
fi

# merge-pr --status: the merge status report, with the next command.
set +e
out="$(PATH="$WORK/bin:$PATH" STUB_LOG="$WORK/log" STUB_HEAD="$HEAD_SHA" STUB_BEHIND=0 "$MESH_DIR/bin/mesh" merge-pr --status "$URL" 2>&1)"
code=$?
set -e
if [ "$code" -ne 0 ] && grep -q "  BLOCKED  evals have not run on head abc1234" <<<"$out" && grep -q "Next: mesh run-evals $URL" <<<"$out"; then
  echo "  PASS: merge-pr --status prints the report and the next command"
else
  echo "  FAIL: merge-pr --status: exit $code"; echo "$out" | sed 's/^/    /'; fails=$((fails + 1))
fi

# --quick: k=1, the first repeat judged, scored with --quick; a PR comment, and never an evals status.
: > "$WORK/log"; rm -f "$WORK/comment"
set +e
PATH="$WORK/bin:$PATH" HOME="$WORK/home" MESH_RUN_EVALS_DIR="$WORK/gates" STUB_LOG="$WORK/log" STUB_HEAD="$HEAD_SHA" \
  STUB_GATE=pass STUB_COMMENT="$WORK/comment" STUB_BASELINE_SEEN="$WORK/baseline-seen" \
  "$MESH_DIR/bin/mesh" run-evals --quick "$URL" >/dev/null 2>&1
code=$?
set -e
if [ "$code" -eq 0 ] && grep -q -- "--run quick-pr15-abc1234 --k 1 --judge-repeats first" "$WORK/log" \
   && grep -q -- "--quick" <(grep "decide_evals_gate_status.py" "$WORK/log") && ! grep -q "context=evals" "$WORK/log" \
   && grep -q "not the gate" "$WORK/comment"; then
  echo "  PASS: --quick runs k=1, comments an early warning and posts no evals status"
else
  echo "  FAIL: --quick (exit $code)"; sed 's/^/    log: /' "$WORK/log"; fails=$((fails + 1))
fi

[ "$fails" -eq 0 ] || exit 1
