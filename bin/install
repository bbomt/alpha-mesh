#!/usr/bin/env bash
# alpha-mesh/bin/install
# Run once after cloning alpha-mesh.

set -euo pipefail

BRAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "=== PMAT Brain Install ==="
echo "Brain dir: $BRAIN_DIR"
echo ""

# ─── Check dependencies ─────────────────────────────────────────────────────
echo "Checking dependencies..."

missing=()
for cmd in jq sqlite3 curl python3; do
  if command -v "$cmd" &>/dev/null; then
    echo "  ✓ $cmd"
  else
    echo "  ✗ $cmd  ← MISSING"
    missing+=("$cmd")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  echo ""
  echo "Install missing dependencies:"
  echo "  sudo apt-get install ${missing[*]}"
  exit 1
fi

echo ""

# ─── Make scripts executable ────────────────────────────────────────────────
echo "Setting script permissions..."
chmod +x "$BRAIN_DIR/bin/"*
echo "  ✓ done"
echo ""

# ─── Create directory structure ─────────────────────────────────────────────
echo "Creating directories..."
mkdir -p \
  "$BRAIN_DIR/config" \
  "$BRAIN_DIR/tasks" \
  "$BRAIN_DIR/memory/sessions" \
  "$BRAIN_DIR/memory/learnings" \
  "$BRAIN_DIR/memory/skills" \
  "$BRAIN_DIR/memory/bootstrap"
echo "  ✓ done"
echo ""

# ─── Initialise empty learnings files ───────────────────────────────────────
for topic in architecture deployment testing models workflow patterns; do
  f="$BRAIN_DIR/memory/learnings/$topic.md"
  if [[ ! -f "$f" ]]; then
    echo "# $topic learnings" > "$f"
    echo "<!-- appended by dream script after each session -->" >> "$f"
  fi
done
echo "  ✓ learnings files initialised"
echo ""

# ─── Write .gitignore ───────────────────────────────────────────────────────
cat > "$BRAIN_DIR/.gitignore" <<'EOF'
# secrets — never commit
config/active.json

# local DB — back up separately, don't commit
tasks/task-log.db
tasks/*.db

# raw bootstrap content (too large, keep locally)
memory/bootstrap/

# editor
.DS_Store
*.swp
EOF
echo "  ✓ .gitignore written"
echo ""

# ─── Add scripts to PATH via shell profile ──────────────────────────────────
SHELL_PROFILE=""
if [[ -f "$HOME/.bashrc" ]]; then
  SHELL_PROFILE="$HOME/.bashrc"
elif [[ -f "$HOME/.bash_profile" ]]; then
  SHELL_PROFILE="$HOME/.bash_profile"
elif [[ -f "$HOME/.zshrc" ]]; then
  SHELL_PROFILE="$HOME/.zshrc"
fi

# Symlink scripts into ~/bin for portable PATH-free access
echo "Creating symlinks in ~/bin..."
mkdir -p "$HOME/bin"
for script in "$BRAIN_DIR/bin/"*; do
  name="$(basename "$script")"
  link="$HOME/bin/$name"
  if [[ -L "$link" ]]; then
    rm "$link"
  fi
  ln -s "$script" "$link"
  echo "  ✓ $name"
done
echo ""

# ─── Prompt for API keys ────────────────────────────────────────────────────
echo "=== API Key Setup ==="
echo "Copy .env.example to .env and add your tokens:"
echo "  cp .env.example .env"
echo "  \$EDITOR .env"
echo ""
echo "Tokens needed:"
echo "  ALPHA_MESH_MINIMAX_TOKEN    → your Minimax sk-cp-... key"
echo "  ALPHA_MESH_OPENROUTER_TOKEN  → your OpenRouter SK/... key"
echo "  ALPHA_MESH_ANTHROPIC_TOKEN   → your Anthropic key (optional)"
echo ""

# ─── Backup existing settings.json ──────────────────────────────────────────
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
if [[ -f "$CLAUDE_SETTINGS" ]]; then
  cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.pre-alpha-mesh.bak"
  echo "  ✓ Backed up existing settings.json → settings.json.pre-alpha-mesh.bak"
  echo "    (alpha-mesh/bin/model will manage this file from now on)"
  echo ""
fi

# ─── Done ───────────────────────────────────────────────────────────────────
echo "=== Install complete ==="
echo ""
echo "Next steps:"
echo "  2. Edit config/models.json — add your API keys"
echo "  3. mesh model use minimax          # verify model switching works"
echo "  4. mesh bootstrap-memory --dry-run # preview historical extraction"
echo "  5. mesh bootstrap-memory           # seed memory from past sessions"
echo "  6. At end of each work session: mesh dream"
echo ""
echo "Daily workflow:"
echo "  mesh model status                  # check active model"
echo "  mesh task-log start PMAT-NNN 'description' --repo PMATFE-xxx"
echo "  ... do work in Claude Code ..."
echo "  mesh task-log done PMAT-NNN --outcome 'shipped X, tests pass'"
echo "  mesh dream                         # consolidate session"
