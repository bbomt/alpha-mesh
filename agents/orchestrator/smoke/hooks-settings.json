{
  "enabledPlugins": {"atlassian@claude-plugins-official": true},
  "sandbox": {
    "filesystem": {"allowWrite": ["~/.mesh", "~/.cache/uv"]},
    "network": {"allowedDomains": [
      "github.com", "api.github.com", "openrouter.ai", "pypi.org", "files.pythonhosted.org",
      "portal.sso.eu-west-1.amazonaws.com", "oidc.eu-west-1.amazonaws.com",
      "sts.amazonaws.com", "sts.eu-west-1.amazonaws.com", "ssm.eu-west-1.amazonaws.com",
      "dynamodb.eu-west-1.amazonaws.com", "*.ddb.eu-west-1.amazonaws.com",
      "s3.eu-west-1.amazonaws.com", "*.s3.eu-west-1.amazonaws.com", "*.s3.amazonaws.com"
    ]}
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "$HOME/environment/pmat/alpha-mesh/agents/orchestrator/smoke/status-hook.sh started"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "$HOME/environment/pmat/alpha-mesh/agents/orchestrator/smoke/status-hook.sh working"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "$HOME/environment/pmat/alpha-mesh/agents/orchestrator/smoke/status-hook.sh idle"}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "$HOME/environment/pmat/alpha-mesh/agents/orchestrator/smoke/status-hook.sh waiting"}]}
    ]
  }
}
