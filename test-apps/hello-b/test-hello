#!/usr/bin/env bash
# alpha-mesh/test-apps/hello-b/test-hello
# Tests for hello.sh: prints "hello world" followed by today's date (ISO 8601)

set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== hello-b tests ==="

# Read the date before and after the run so a run across midnight still passes.
before="$(date +%F)"
output="$("$APP_DIR/hello.sh")"
after="$(date +%F)"

if [[ "$output" == "hello world $before" || "$output" == "hello world $after" ]]; then
  echo "PASS: printed '$output'"
else
  echo "FAIL: expected 'hello world $before', got '$output'"
  exit 1
fi
