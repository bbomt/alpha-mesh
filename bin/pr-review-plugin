#!/usr/bin/env bash
# alpha-mesh/bin/pr-review-plugin
# Entry point for the plugin-based pr-review agent (PMAT-188).
# Usage: pr-review-plugin <pr-url> [options]
#   or: mesh pr-review-plugin <pr-url> [options]

set -euo pipefail

# Resolve actual script path (handles symlinks)
SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
MESH_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
AGENT_DIR="$MESH_DIR/agents/pr-review"

# Determine repo path: use --repo-path from args or current directory
REPO_PATH=""
for ((i=1; i<=$#; i++)); do
    arg="${!i}"
    if [[ "$arg" == "--repo-path" ]] && [[ $((i+1)) -le $# ]]; then
        j=$((i+1))
        REPO_PATH="${!j}"
        break
    fi
done

if [[ -z "$REPO_PATH" ]]; then
    REPO_PATH="$PWD"
fi

export REPO_PATH

cd "$AGENT_DIR"

# Run the plugin-based CLI
exec uv run python -m pr_review.plugin_cli --repo-path "$REPO_PATH" "$@"