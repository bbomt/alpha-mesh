#!/usr/bin/env bash
# alpha-mesh/scripts/model
# Replaces manual settings.json swapping.
# Tokens: stored in env vars or .env (never commit secrets to GitHub)
# Usage:
#   model use minimax
#   model use openrouter          # uses openrouter-default
#   model use openrouter <model>  # override model, e.g. deepseek/deepseek-v4-flash
#   model status
#   model check minimax           # health check without switching
#   model list

set -euo pipefail

# Resolve script's real directory regardless of cwd
SCRIPT_REALPATH="$(readlink -f "${BASH_SOURCE[0]}")"
BRAIN_DIR="$(cd "$(dirname "$SCRIPT_REALPATH")/.." && pwd)"
MODELS_JSON="$BRAIN_DIR/config/models.json"
ACTIVE_JSON="$BRAIN_DIR/config/active.json"
ENV_FILE="$BRAIN_DIR/.env"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"

# Requires jq
if ! command -v jq &>/dev/null; then
  echo "ERROR: jq is required. Install with: sudo apt-get install jq" >&2
  exit 1
fi

# Load .env if it exists
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

cmd="${1:-status}"

# Resolve shorthand profile name to full name
# e.g. "openrouter" → "openrouter-default", "claude" → "claude-sonnet"
resolve_profile() {
  local shorthand="$1"
  # Exact match
  if jq -e --arg p "$shorthand" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
    echo "$shorthand"
    return 0
  fi
  # Provider shorthand → profile mapping
  case "$shorthand" in
    openrouter) echo "openrouter-default" ;;
    claude)     echo "claude-sonnet" ;;
    *)          # Try appending common suffixes
      for suffix in "-default" "-claude" "-sonnet" "-haiku" "-opus"; do
        local candidate="${shorthand}${suffix}"
        if jq -e --arg p "$candidate" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
          echo "$candidate"
          return 0
        fi
      done
      echo "$shorthand"
      ;;
  esac
}

list_profiles() {
  echo "Available model profiles:"
  jq -r '.profiles | to_entries[] | "  \(.key)  —  \(.value.description)"' "$MODELS_JSON"
  echo ""
  default=$(jq -r '.default' "$MODELS_JSON")
  echo "Default: $default"
}

get_active_profile() {
  if [[ -f "$ACTIVE_JSON" ]]; then
    jq -r '.profile' "$ACTIVE_JSON"
  else
    jq -r '.default' "$MODELS_JSON"
  fi
}

# Get token for a profile: env var takes precedence over models.json placeholder
# Env var name is ALPHA_MESH_{PROVIDER}_TOKEN where provider comes from models.json
# e.g. "openrouter-default" has provider "openrouter" → ALPHA_MESH_OPENROUTER_TOKEN
#       "claude-sonnet" has provider "anthropic" → ALPHA_MESH_ANTHROPIC_TOKEN
get_token() {
  local profile="$1"
  local provider
  provider=$(jq -r --arg p "$profile" '.profiles[$p].provider // ($p | split("-")[0])' "$MODELS_JSON")
  local env_var="ALPHA_MESH_${provider^^}_TOKEN"
  local token="${!env_var:-}"

  # If env var is set, use it; otherwise fall back to models.json
  if [[ -n "$token" ]]; then
    echo "$token"
  else
    jq -r --arg p "$profile" '.profiles[$p].env.ANTHROPIC_AUTH_TOKEN // .profiles[$p].env.ANTHROPIC_API_KEY // ""' "$MODELS_JSON"
  fi
}

health_check() {
  local profile="$1"
  local base_url token

  base_url=$(jq -r --arg p "$profile" '.profiles[$p].env.ANTHROPIC_BASE_URL' "$MODELS_JSON")

  if [[ -z "$base_url" || "$base_url" == "null" ]]; then
    # Native Anthropic — check api.anthropic.com
    base_url="https://api.anthropic.com"
  fi

  # Check the actual API endpoint (append /v1/models for health check)
  # This avoids false negatives from stripped paths
  health_url="${base_url%/}/v1/models"

  echo -n "  Checking $profile ($health_url) ... "
  token=$(get_token "$profile")
  if [[ -z "$token" || "$token" == "REPLACE_WITH_"* ]]; then
    echo "⚠ no token configured (set ALPHA_MESH_${profile^^}_TOKEN env var or in config/.env)"
    return 1
  fi

  if curl -sf --max-time 5 "$health_url" \
    -H "Authorization: Bearer $token" \
    -o /dev/null 2>&1; then
    echo "✓ reachable"
    return 0
  else
    echo "✗ unreachable"
    return 1
  fi
}

write_settings() {
  local profile="$1"
  local model_override="${2:-}"

  # Validate profile exists
  if ! jq -e --arg p "$profile" '.profiles[$p]' "$MODELS_JSON" > /dev/null 2>&1; then
    echo "ERROR: Unknown profile '$profile'" >&2
    echo "Run: model list" >&2
    exit 1
  fi

  # Build env block from models.json, then overlay token and optionally model
  local env_block token
  env_block=$(jq --arg p "$profile" '.profiles[$p].env' "$MODELS_JSON")
  token=$(get_token "$profile")

  # Replace the token and optionally override the model
  # Only set ANTHROPIC_API_KEY when models.json explicitly has a value for it (used by Anthropic direct)
  # ANTHROPIC_AUTH_TOKEN is always set (used by minimax/openrouter)
  if [[ -n "$model_override" ]]; then
    env_block=$(echo "$env_block" | jq \
      --arg token "$token" \
      --arg model "$model_override" \
      '.ANTHROPIC_AUTH_TOKEN = $token | .ANTHROPIC_MODEL = $model | .ANTHROPIC_DEFAULT_SONNET_MODEL = $model | .ANTHROPIC_DEFAULT_OPUS_MODEL = $model | if (.ANTHROPIC_API_KEY | length > 0) then .ANTHROPIC_API_KEY = $token else . end')
  else
    env_block=$(echo "$env_block" | jq \
      --arg token "$token" \
      '.ANTHROPIC_AUTH_TOKEN = $token | if (.ANTHROPIC_API_KEY | length > 0) then .ANTHROPIC_API_KEY = $token else . end')
  fi

  # Backup existing settings
  if [[ -f "$CLAUDE_SETTINGS" ]]; then
    cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.bak"
  fi

  # Write new settings
  jq -n --argjson env "$env_block" '{"env": $env}' > "$CLAUDE_SETTINGS"

  # Write active profile record
  jq -n \
    --arg profile "$profile" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{"profile": $profile, "activated_at": $ts}' > "$ACTIVE_JSON"

  echo "✓ Active model: $profile${model_override:+, model: '"$model_override"'}"
  jq -r --arg p "$profile" '.profiles[$p].description' "$MODELS_JSON"
}

case "$cmd" in
  list)
    list_profiles
    ;;

  status)
    active=$(get_active_profile)
    echo "Active profile: $active"
    if [[ -f "$ACTIVE_JSON" ]]; then
      activated=$(jq -r '.activated_at' "$ACTIVE_JSON")
      echo "Since: $activated"
    fi
    desc=$(jq -r --arg p "$active" '.profiles[$p].description' "$MODELS_JSON")
    echo "Description: $desc"
    echo ""
    echo "settings.json → $CLAUDE_SETTINGS"
    ;;

  use)
    profile="${2:-}"
    model_override="${3:-}"

    if [[ -z "$profile" ]]; then
      echo "Usage: model use <profile> [model]" >&2
      echo "  e.g. model use minimax" >&2
      echo "  e.g. model use openrouter glm-5.1         # use profile's default model" >&2
      echo "  e.g. model use openrouter deepseek/deepseek-v4-flash  # override model" >&2
      list_profiles
      exit 1
    fi

    # Support: model use provider/model  (slash-separated shorthand)
    if [[ -z "$model_override" && "$profile" == *"/"* ]]; then
      model_override="${profile#*/}"
      profile="${profile%%/*}"
    fi

    profile=$(resolve_profile "$profile")

    echo "Switching to: $profile${model_override:+, model: '"$model_override"'}"
    health_check "$profile" || {
      echo ""
      echo "WARNING: $profile appears unreachable. Checking fallbacks..."
      fallbacks=$(jq -r '.fallback_order[]' "$MODELS_JSON")
      for fb in $fallbacks; do
        [[ "$fb" == "$profile" ]] && continue
        health_check "$fb" && {
          echo ""
          read -rp "Use $fb instead? [y/N] " confirm
          [[ "$confirm" =~ ^[Yy]$ ]] && profile="$fb" && break
        }
      done
    }
    write_settings "$profile" "$model_override"
    ;;

  check)
    profile="${2:-$(get_active_profile)}"
    echo "Health checking: $profile"
    health_check "$profile"
    ;;

  *)
    echo "Usage: model <command>"
    echo "Commands: use <profile> | status | list | check [profile]"
    exit 1
    ;;
esac
